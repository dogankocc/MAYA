{"intent":"technical","messages":[{"role":"user","content":"Aşağıda, kullanıcı dostu bir arayüze sahip, C++ dilinde Knuth-Morris-Pratt algoritmasını (KMP) kullanarak bir dizi içinde alt dizesinin bulunup bulunmadığını kontrol eden, iyi"},{"role":"assistant","content":"#include <iostream> #include <string> #include <vector> using namespace std; void computeLPS(string pattern, vector<int>& LPS) { int n = pattern.length(); int len = 0; LPS[0] = 0; for(int I = 1; I < n; I++) { if(pattern[I] == pattern[len]) { len++; LPS[I] = len; } else { if(len != 0) { len = LPS[len - 1]; I--; } else LPS[I] = 0; } } } void KMP(string text, string pattern) { int n = text.length(); int m = pattern.length(); vector<int> LPS(m); computeLPS(pattern, LPS); int I = 0; // Metin dizisi için indeks int j = 0; // Desen dizisi için indeks while (I < n) { if (pattern[j] == text[I]) { j++; I++;"}]}
