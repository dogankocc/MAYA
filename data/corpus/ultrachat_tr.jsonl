{"intent":"general","messages":[{"role":"user","content":"C++ dilinde, verimli aralık sorguları ve güncellemeleri destekleyen bir dalgaleti (wavelet tree) veri yapısı uygulaması yapalım. Bu yapı; - Ağacı inşa etme - Belirli bir"},{"role":"assistant","content":"İşte C++ dilinde, aralık sorguları ve güncellemeleri etkin bir şekilde destekleyen wavelet ağacının örnek bir uygulaması: ``` #include <bits/stdc++.h> using namespace std; const int MAXN = 1e5; class WaveletTree { private: int n, max_val, height; vector<vector<int>> bit_arr, left_cnt; vector<int> zeros; void build(int l, int r, int h, const vector<int>& arr) { if (l >= r // h > height) { return; } int mid = (l + r) >> 1; bit_arr[h].resize(r - l + 1); left_cnt[h].resize(r - l + 1); left_cnt[h][0] = 0; for (int i = l; i <= r; ++i) { bit_arr[h][i - l] = (arr[i] >> (height - h - 1)) & 1;"}]}
